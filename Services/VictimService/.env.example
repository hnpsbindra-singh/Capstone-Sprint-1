# ==============================================================================
# VictimService Environment Configuration Template (.env.example)
# ==============================================================================

# Server Port
PORT=5005

# MongoDB Database URI (e.g. MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/VictimDB?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/VictimDB?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Inter-Service Communication
AUTH_SERVICE_URL=https://capstone-sprint-1.vercel.app
AI_SERVICE_URL=https://flood-severity-analyzer.vercel.app/api/v1/score-base64

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
