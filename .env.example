# ==============================================================================
# ResQFlow Environment Configuration Template (.env.example)
# Copy this file to .env in each service directory (or share across services)
# and populate with actual credentials before starting.
# ==============================================================================

# Node Environment
NODE_ENV=production

# JWT Authentication Secret (MUST be at least 32 characters long, matching across all services)
JWT_SECRET=replace_with_a_secure_random_32_plus_character_string
JWT_EXP=24h

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_SENDER_EMAIL=notifications@yourdomain.com
BREVO_SENDER_NAME=ResQFlow Relief Network

# Redis (Used by Auth Service for OTP storage and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace_with_redis_password
REDIS_TLS=false

# MongoDB Database URIs (per service or shared cluster)
MONGO_URI=mongodb://localhost:27017/ResQFlowDB

# Microservice Ports
PORT_AUTH=5001
PORT_NGO=5002
PORT_DONOR=5003
PORT_ADMIN=5004
PORT_VICTIM=5005

# Internal Microservice Routing URLs
AUTH_URL=http://localhost:5001
NGO_URL=http://localhost:5002
DONOR_URL=http://localhost:5003
ADMIN_URL=http://localhost:5004
VICTIM_URL=http://localhost:5005
AI_SERVICE_URL=http://localhost:8000
