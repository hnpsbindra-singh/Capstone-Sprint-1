# ==============================================================================
# ResQFlow Environment Configuration Template (.env.example)
# Copy this file to .env in each service directory (or share across services)
# and populate with actual credentials before starting.
# ==============================================================================

# Node Environment
NODE_ENV=development

# JWT Authentication Secret (MUST match across all Spring Boot & Node.js services)
JWT_SECRET=IAmSonOfGurvinderSinghWithNameHarnimarPreetSinghAge19AndSexMaleWantingAFemale
JWT_EXP=24h

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=notifications@resqflow.org
BREVO_SENDER_NAME=ResQFlow Relief Network

# Redis (Used by Auth Service for OTP storage and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false

# MongoDB Database URIs (per service or shared cluster)
MONGO_URI=mongodb://localhost:27017/CapstoneDB
AUTH_MONGO_URI=mongodb://localhost:27017/AuthServiceDB
NGO_MONGO_URI=mongodb://localhost:27017/NgoServiceDB
DONOR_MONGO_URI=mongodb://localhost:27017/DonorServiceDB
ADMIN_MONGO_URI=mongodb://localhost:27017/AdminServiceDB

# Microservice Ports
PORT_GATEWAY=8080
PORT_AUTH=5001
PORT_NGO=5002
PORT_DONOR=5003
PORT_ADMIN=5004
PORT_VICTIM=5005

# Internal Microservice Routing URLs
AUTH_URL=https://capstone-sprint-1.vercel.app
NGO_URL=https://ngoservice.vercel.app
DONOR_URL=https://donorservice.vercel.app
ADMIN_URL=http://localhost:5004
VICTIM_URL=https://victim-service-latest.onrender.com
AI_SERVICE_URL=https://flood-severity-analyzer.vercel.app
